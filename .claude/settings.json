{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun packages/uredu/src/bin.ts hook claude"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bun packages/uredu/src/bin.ts hook claude"
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun packages/uredu/src/bin.ts hook claude"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun packages/uredu/src/bin.ts hook claude"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Edit(uredu.ts)",
      "Write(uredu.ts)",
      "Edit(**/uredu.ts)",
      "Write(**/uredu.ts)",
      "Bash(git update-ref refs/uredu/*)"
    ]
  }
}
